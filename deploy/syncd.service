[Unit]
Description=syncd git object hub (Forgejo / GitHub / GitLawb)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=git
Group=git
UMask=0077
WorkingDirectory=/var/lib/syncd
# /etc/syncd.yaml holds a Forgejo write token and hook secrets.
ExecStartPre=/usr/bin/chmod 0600 /etc/syncd.yaml
ExecStart=/usr/local/bin/syncd -config /etc/syncd.yaml
Restart=always
RestartSec=2
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
